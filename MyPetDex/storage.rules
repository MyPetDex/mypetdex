rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper: user is signed in
    function isSignedIn() {
      return request.auth != null;
    }
    // Helper: requesting user owns this uid's storage path
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // Helper: user is the admin
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'mypetdexapp@gmail.com';
    }
    // Helper: upload is a valid image under 8 MB
    function isValidImage() {
      return request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Pet photos live at users/{uid}/pets/{petId}/photo.jpg
    // Only the owning user (or admin) may read/write; writes must be valid images
    match /users/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if (isOwner(uid) || isAdmin()) && isValidImage();
    }

    // Shelter pet photos at shelters/{uid}/pets/**
    // Only the owning shelter may write; reads open to any signed-in user (adoption listings)
    match /shelters/{uid}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if (isOwner(uid) || isAdmin()) && isValidImage();
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
